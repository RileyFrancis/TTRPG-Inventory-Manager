# Firebase Realtime Database credentials for party play.
#
# Copy this file to `.env` and fill in your own project's values:
#
#     cp .env.example .env
#
# Find them at: Firebase Console → Project settings → Your apps → SDK setup
# and configuration → Config.
#
# Without a `.env` the app runs fully offline; only party features are disabled.
#
# ---------------------------------------------------------------------------
# NOTE: `.env` is served to the browser over HTTP — it is fetched at page load,
# which means anyone who can reach the site can read it at /.env. That is fine
# for these values (Firebase web config is public by design; access is enforced
# by your Realtime Database rules, not by hiding these keys). Do NOT put real
# secrets — API tokens, private keys, passwords — in this file.
# ---------------------------------------------------------------------------

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
